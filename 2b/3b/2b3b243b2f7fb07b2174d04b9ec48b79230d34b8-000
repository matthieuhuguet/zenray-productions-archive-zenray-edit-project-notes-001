      italic: 'font-style: italic; font-size: 1.12em; color: var(--zr-muted); padding: 0 1.6em; border: none; text-align: center;'
    }[p.quoteStyle];
    var out = [];
    out.push('/* ' + design.file + ' : thème QLMarkdown ZenRay ' + design.id + ' (' + design.name + '), généré le ' + (opts.date || '25 October 2026') + ' par ThemeEngine.js.');
    out.push('   Modifier les valeurs dans la page index.html de l’atelier, puis Scripts/BuildThemes.mjs --install. */');
    out.push(fonts(!!opts.withUrls));
    out.push(':root {\n' + palette(p, scheme === 'dark') + '\n  --zr-radius: ' + p.radius + 'px;\n  color-scheme: ' + (scheme === 'auto' ? 'light dark' : scheme) + ';\n}');
    if (scheme === 'auto') out.push('@media (prefers-color-scheme: dark) {\n  :root {\n' + palette(p, true) + '\n  }\n}');
