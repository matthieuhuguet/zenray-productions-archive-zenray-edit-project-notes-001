    return [
      ['ZR Title', 'italic', src('GTSectraLCG-RegularItalic', 'GT-Sectra-LCGV-Regular-Italic.woff2'), ''],
      ['ZR Title', 'normal', src('GTSectraLCG-Regular', 'GT-Sectra-LCGV-Regular.woff2'), ''],
      ['ZR Title', 'italic', src('AnthropicSerif-Regular', 'AnthropicSerif-Regular.ttf'), digits],
      ['ZR Title', 'normal', src('AnthropicSerif-Regular', 'AnthropicSerif-Regular.ttf'), digits],
      ['ZR Body', 'normal', src('AnthropicSerif-Regular', 'AnthropicSerif-Regular.ttf'), ''],
      ['ZR Body', 'italic', src('AnthropicSerif-Italic', 'AnthropicSerif-Italics.woff2'), ''],
      ['ZR Mono', 'normal', src('AnthropicMono-Regular', 'AnthropicMono-Regular.ttf'), ''],
      ['ZR UI', 'normal', src('InterVariable', 'InterVariable.woff2'), '']
    ].map(function (f) {
      return '@font-face { font-family: "' + f[0] + '"; font-style: ' + f[1] + '; font-weight: 400; src: ' + f[2] + ';' +
        (f[3] ? ' unicode-range: ' + f[3] + ';' : '') + ' }';
    }).join('\n');
  }

  function palette(p, dark) {
    var k = dark ? ['dBg', 'dInk', 'dMuted', 'dAccent', 'dRule', 'dBlock'] : ['bg', 'ink', 'muted', 'accent', 'rule', 'block'];
    return '  --zr-bg: ' + p[k[0]] + '; --zr-ink: ' + p[k[1]] + '; --zr-muted: ' + p[k[2]] + ';\n' +
      '  --zr-accent: ' + p[k[3]] + '; --zr-rule: ' + p[k[4]] + '; --zr-block: ' + p[k[5]] + ';';
  }

  // scheme: 'auto' writes the prefers-color-scheme media query (installed theme);
  // 'light' or 'dark' forces one palette (preview). FR : 'auto' pour QLMarkdown, forcé pour l'aperçu.
  function css(design, p, opts) {
    opts = opts || {};
    var scheme = opts.scheme || 'auto';
    var r = p.titleRatio, h1 = p.h1Scale;
    var sizes = [h1, h1 / r, h1 / r / r, h1 / r / r / r, 1.05, 1].map(function (v) { return Math.max(v, 1).toFixed(3) + 'em'; });
    var measure = Number(p.measure) > 0 ? p.measure + 'ch' : 'none';
    var quote = {
      bar: 'border-left: 3px solid var(--zr-accent); background: var(--zr-block); padding: 0.6em 1.1em; border-radius: 0 var(--zr-radius) var(--zr-radius) 0; color: var(--zr-muted);',
