  // Font faces. Titles use one family made of two faces: digits and euro from Anthropic Serif
  // upright, every other glyph from GT Sectra LCG. local() names are PostScript names measured
  // with fc-scan on 25 October 2026; url() is only used by the preview page.
  // FR : les chiffres d'un titre restent droits en Anthropic Serif, par unicode-range.
  function fonts(withUrls) {
    function src(ps, file) { return 'local("' + ps + '")' + (withUrls ? ', url("fonts/' + file + '")' : ''); }
