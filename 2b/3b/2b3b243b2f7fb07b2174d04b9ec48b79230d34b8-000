      'html, body { background: var(--zr-bg) !important; color: var(--zr-ink); margin: 0; }',
      'body { font-family: "ZR Body", "AnthropicSerif", Georgia, serif; font-weight: 400; font-size: ' + p.baseSize + 'px; line-height: ' + p.lineHeight + '; -webkit-font-smoothing: antialiased; font-variant-numeric: lining-nums; }',
