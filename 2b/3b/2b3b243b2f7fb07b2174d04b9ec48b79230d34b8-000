      'h2 { font-size: ' + sizes[1] + ';' + (p.h2Rule === 'on' ? ' padding-bottom: 0.25em; border-bottom: 1px solid var(--zr-rule);' : '') + ' }',
      'h3 { font-size: ' + sizes[2] + '; } h4 { font-size: ' + sizes[3] + '; color: var(--zr-muted); } h5 { font-size: ' + sizes[4] + '; } h6 { font-size: ' + sizes[5] + '; color: var(--zr-muted); }',
      'p, ul, ol, table, pre, blockquote { margin: 0 0 1em; }',
      'a { color: var(--zr-accent); text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--zr-accent) 35%, transparent); }',
      'a:hover { border-bottom-color: var(--zr-accent); }',
      'strong { font-weight: 700; } em { font-style: italic; }',
      'blockquote { margin-left: 0; margin-right: 0; ' + quote + ' }',
      'blockquote p:last-child { margin-bottom: 0; }',
      'code, pre, kbd, tt { font-family: "ZR Mono", "AnthropicMono", ui-monospace, monospace; font-size: 0.86em; }',
